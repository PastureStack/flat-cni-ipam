#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${VERSION_OVERRIDE:-}" ]]; then
    VERSION="${VERSION_OVERRIDE}"
else
    VERSION="$(git describe --tags --always --dirty 2>/dev/null || printf 'dev')"
fi
plain_version="${VERSION#v}"
if [[ -n "${VERSION_OVERRIDE:-}" && ! "$plain_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    printf 'VERSION must be a plain numeric semantic version: %s\n' "$VERSION" >&2
    exit 1
fi
if [[ "$plain_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    VERSION="$plain_version"
fi
export VERSION
