#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
test -z "$(gofmt -l .)"
go vet ./...
go mod verify
test "$(go env GOVERSION)" = "go1.26.5"
grep -F 'go 1.26.5' go.mod >/dev/null
grep -F 'github.com/containernetworking/cni v1.3.0' go.mod >/dev/null
grep -F 'github.com/vishvananda/netns v0.0.5' go.mod >/dev/null
grep -F 'golang.org/x/sys v0.47.0' go.mod >/dev/null
grep -F 'type policyTransport struct' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'isValidRedirectURL' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'os.ReadFile(metadataCARootPath)' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'root.OpenFile(relativePath' main.go >/dev/null
bash ./scripts/verify-licenses
bash ./scripts/verify-public-tree
